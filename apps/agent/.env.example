# ── LLM API Keys ──────────────────────────────────────────
# Primary: Anthropic Claude (recommended - better tool use & safety)
ANTHROPIC_API_KEY=your_anthropic_api_key_here

# Fallback: OpenAI GPT-4o
OPENAI_API_KEY=your_openai_api_key_here

# ── Ghostfolio ─────────────────────────────────────────────
# Required — set to YOUR Ghostfolio instance URL (no trailing slash).
# Production (Railway):  https://ghostfolio-production-453e.up.railway.app
# Local dev:             http://localhost:3333
GHOSTFOLIO_BASE_URL=https://ghostfolio-production-453e.up.railway.app

# Ghostfolio bearer token (get via POST /api/v1/auth/anonymous)
GHOSTFOLIO_ACCESS_TOKEN=your_ghostfolio_security_token
GHOSTFOLIO_PUBLIC_ACCESS_ID=your_public_access_id

# ── Observability ──────────────────────────────────────────
LANGCHAIN_TRACING_V2=true
LANGCHAIN_API_KEY=your_langsmith_api_key_here
LANGCHAIN_PROJECT=fortio-agent

# ── Database (for LangGraph checkpointing) ────────────────
DATABASE_URL=postgresql://postgres:password@localhost:5432/agentforge

# ── Redis (caching) ────────────────────────────────────────
# DB 0 is used by Ghostfolio; DB 1 is reserved for the Fortio agent.
# Using separate logical DBs keeps the two services' keyspaces isolated.
REDIS_URL=redis://localhost:6379/1

# ── CORS ────────────────────────────────────────────────────
# Comma-separated list of allowed origins for the Fortio API.
# Defaults (set in config.py) already cover localhost:4200/3333 and the
# Railway Ghostfolio URL. Only set this if you need to override them.
#
# Format: comma-separated (no quotes, no brackets needed)
CORS_ORIGINS=http://localhost:4200,https://localhost:4200,http://localhost:3333,https://localhost:3333,https://ghostfolio-production-453e.up.railway.app

# ── App Settings ───────────────────────────────────────────
ENVIRONMENT=development
LOG_LEVEL=INFO
PORTFOLIO_CONCENTRATION_THRESHOLD=0.20
MARKET_DATA_FRESHNESS_MINUTES=15
MAX_TOOL_RETRIES=2

# ── FIRE Goal Tracker (optional add-on) ────────────────
# Set to true to enable the FIRE Goal Tracker feature and its 5 tools.
FIRE_TRACKER_ENABLED=false

# Free FRED API key from the Federal Reserve Economic Data.
# Register at: https://fred.stlouisfed.org/docs/api/api_key.html
# Required only when FIRE_TRACKER_ENABLED=true
FRED_API_KEY=your_fred_api_key_here
