      "runtimeExecutable": "npm",
      "runtimeArgs": ["run", "start:server"],
      "port": 3333
    },
    {
      "name": "ghostfolio-client",
      "runtimeExecutable": "npm",
      "runtimeArgs": ["run", "start:client"],
      "port": 4200
    },
    {
